# Self-hosted (env) mode configuration — all optional.
# In hosted mode these live in the addon URL generated by /configure instead.

# Letterboxd username — enables the RSS delta (requires a public profile)
LETTERBOXD_USERNAME=

# Free TMDB API key — used only for the few RSS id mappings Wikidata misses
TMDB_API_KEY=

# Override the chart source entirely (URL of a snapshot JSON)
TOP250_SNAPSHOT_URL=

# Display name of the catalog in Stremio
CATALOG_NAME=IMDb Top 250 — À voir

# Port for the Node runtime
PORT=7146
